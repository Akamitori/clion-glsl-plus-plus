<idea-plugin>
    <id>dev.akamitori.glsl</id>
    <name>GLSL++</name>
    <vendor>Akamitori</vendor>
    <description><![CDATA[
    <p>GLSL shader support for CLion, including CLion Nova: navigation, real compiler errors as you type,
       rename, formatting and semantic highlighting.</p>
    <ul>
      <li><b>Navigation and docs</b>: Go to Declaration (Ctrl+B / Ctrl+click), hover docs,
          completion and Reformat Code, via the
          <a href="https://github.com/nolanderc/glsl_analyzer">glsl_analyzer</a> language server.</li>
      <li><b>Error checking</b>: undeclared identifiers, type and syntax errors as you type, via
          <a href="https://github.com/KhronosGroup/glslang">glslang</a>, with <code>#include</code> resolved.
          OpenGL or Vulkan target, defines and include folders per project.</li>
      <li><b>Rename</b> (Shift+F6) for functions, variables, parameters, struct members and macros, across files.</li>
      <li><b>Highlighting</b>: instant lexer colours plus semantic colours for your functions, parameters, globals,
          structs, fields, swizzles, macros and layout qualifiers, with built-in functions in their own colour.</li>
    </ul>
    <p>glsl_analyzer and glslang are bundled for Linux x64 and Windows x64, so nothing else needs installing there.
       On macOS (not bundled) install them and they are picked up from <code>PATH</code>, or set their paths in
       Settings | Languages &amp; Frameworks | GLSL.</p>
    <p>The plugin is MIT-licensed. It ships unmodified releases of glsl_analyzer
       (<a href="https://github.com/nolanderc/glsl_analyzer/tree/v1.7.1">GPL-3.0, source</a>) and glslang
       (<a href="https://github.com/KhronosGroup/glslang/tree/16.6.0">BSD-3-Clause and others, source</a>), which run as
       separate programs; their license texts are in the plugin's <code>licenses</code> folder.</p>
    ]]></description>

    <change-notes><![CDATA[
    <p><b>1.0.1</b>: first public release.</p>
    <ul>
      <li>Go to Declaration, hover docs, completion and Reformat Code (glsl_analyzer, bundled).</li>
      <li>Compiler errors as you type (glslang, bundled), all at once, with <code>#include</code>, defines and an
          OpenGL or Vulkan target per project; include libraries are checked through the shaders that use them.</li>
      <li>Rename and Find Usages across files; folding, structure view and breadcrumbs.</li>
      <li>Semantic colours for your functions, parameters, globals, structs, fields, macros, with built-ins apart.</li>
      <li>Works next to other GLSL plugins, and warns if one of them owns some shader extensions.</li>
    </ul>
    <p>Full history: <a href="https://github.com/Akamitori/clion-glsl/blob/main/CHANGELOG.md">CHANGELOG.md</a>.</p>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="dev.akamitori.glsl"
                  language="dev.akamitori.glsl"
                  implementationClass="dev.akamitori.glsl.GlslFileType"
                  fieldName="INSTANCE"
                  extensions="glsl;vert;frag;geom;comp;tesc;tese;mesh;task;rgen;rint;rahit;rchit;rmiss;rcall;vsh;fsh"/>

        <lang.parserDefinition language="dev.akamitori.glsl" implementationClass="dev.akamitori.glsl.GlslParserDefinition"/>
        <lang.syntaxHighlighterFactory language="dev.akamitori.glsl" implementationClass="dev.akamitori.glsl.GlslSyntaxHighlighterFactory"/>
        <lang.commenter language="dev.akamitori.glsl" implementationClass="dev.akamitori.glsl.GlslCommenter"/>
        <lang.braceMatcher language="dev.akamitori.glsl" implementationClass="dev.akamitori.glsl.GlslBraceMatcher"/>
        <colorSettingsPage implementation="dev.akamitori.glsl.GlslColorSettingsPage"/>
        <!-- Our own defaults for the bundled schemes; each is set explicitly since palettes differ per theme. -->
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/GlslDarcula.xml"/>
        <additionalTextAttributes scheme="Dark" file="colorSchemes/GlslDark.xml"/>
        <additionalTextAttributes scheme="Islands Dark" file="colorSchemes/GlslDark.xml"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/GlslDefault.xml"/>
        <additionalTextAttributes scheme="Light" file="colorSchemes/GlslDefault.xml"/>
        <additionalTextAttributes scheme="IntelliJ Light" file="colorSchemes/GlslDefault.xml"/>

        <projectConfigurable parentId="language"
                                 id="dev.akamitori.glsl.settings"
                                 displayName="GLSL"
                                 instance="dev.akamitori.glsl.GlslConfigurable"/>

        <notificationGroup id="GLSL" displayType="BALLOON"/>
        <!-- Warns when another plugin (or a user mapping) owns some of our extensions. -->
        <postStartupActivity implementation="dev.akamitori.glsl.GlslConflictCheck"/>

        <platform.lsp.integrationProvider implementation="dev.akamitori.glsl.GlslLspIntegrationProvider"/>

        <!-- Context-aware identifier colours (functions, params, globals, structs, fields, macros). -->
        <annotator language="dev.akamitori.glsl" implementationClass="dev.akamitori.glsl.GlslSemanticAnnotator"/>

        <lang.foldingBuilder language="dev.akamitori.glsl" implementationClass="dev.akamitori.glsl.GlslFoldingBuilder"/>
        <lang.psiStructureViewFactory language="dev.akamitori.glsl" implementationClass="dev.akamitori.glsl.GlslStructureViewFactory"/>
        <breadcrumbsInfoProvider implementation="dev.akamitori.glsl.GlslBreadcrumbsProvider"/>

        <!-- glsl_analyzer sends no diagnostics; glslang provides them. -->
        <externalAnnotator language="dev.akamitori.glsl" implementationClass="dev.akamitori.glsl.GlslangAnnotator"/>

        <!-- Our Ctrl+B / Ctrl+click / Shift+F6 / Alt+F7 / Ctrl+Alt+L actions win over the stock ones in GLSL editors. -->
        <actionPromoter implementation="dev.akamitori.glsl.GlslActionPromoter"/>
    </extensions>

    <actions>
        <!--
          CLion Nova reroutes the stock GotoDeclaration action to the ReSharper backend for files in the
          project, which knows nothing about GLSL. This copy has its own id, so it stays on the IntelliJ side
          and resolves through the LSP client. It is only enabled in GLSL files.
        -->
        <action id="dev.akamitori.glsl.GotoDeclaration"
                class="dev.akamitori.glsl.GlslGotoDeclarationAction"
                text="Go to Declaration (GLSL)">
            <keyboard-shortcut keymap="$default" first-keystroke="control B"/>
            <mouse-shortcut keymap="$default" keystroke="control button1"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta B"/>
            <mouse-shortcut keymap="Mac OS X 10.5+" keystroke="meta button1"/>
        </action>
        <!-- Same story for Rename: glsl_analyzer can't rename, and Nova sends the stock one to its C++ backend. -->
        <action id="dev.akamitori.glsl.Rename"
                class="dev.akamitori.glsl.GlslRenameAction"
                text="Rename (GLSL)…">
            <keyboard-shortcut keymap="$default" first-keystroke="shift F6"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="shift F6"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <!-- Find Usages: glsl_analyzer has no references support, and Nova reroutes the stock one too. -->
        <action id="dev.akamitori.glsl.FindUsages"
                class="dev.akamitori.glsl.GlslFindUsagesAction"
                text="Find Usages (GLSL)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt F7"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt F7"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <!-- And Reformat Code: Nova sends the stock one to its C++ backend, so glsl_analyzer never saw it. -->
        <action id="dev.akamitori.glsl.Reformat"
                class="dev.akamitori.glsl.GlslReformatAction"
                text="Reformat GLSL">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt L"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt L"/>
        </action>
    </actions>
</idea-plugin>
